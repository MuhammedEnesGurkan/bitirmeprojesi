DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soc_ai_panel?schema=public"
MODEL_API_URL="https://your-ngrok-url.ngrok-free.app"
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"

AUTOMATION_ENABLED=false
AUTOMATION_MIN_SEVERITY="MEDIUM"
AUTOMATION_TIMEOUT_MS=15000

TRIAGE_ENGINE_ENABLED=true
TRIAGE_SKIP_LLM_CONFIDENCE_THRESHOLD=0.72
TRIAGE_SKIP_LLM_FOR_LOW_RISK_FP=true

# Create a Shuffle workflow with a webhook trigger and paste its full webhook URL here.
SHUFFLE_AUTOMATION_WEBHOOK_URL=""

# TheHive case creation. Keep the API key secret.
THEHIVE_API_URL="http://100.77.24.25:9000"
THEHIVE_API_KEY=""
THEHIVE_DIRECT_CASE_CREATION=true
THEHIVE_CASE_ENDPOINT="/api/v1/case"
THEHIVE_CASE_SEARCH_ENDPOINT="/api/case/_search"
THEHIVE_ORGANISATION=""
THEHIVE_AUTH_HEADER="Authorization"
THEHIVE_AUTH_SCHEME="Bearer"
THEHIVE_TIMEOUT_MS=15000
THEHIVE_ASSIGNEE_CRITICAL=""
THEHIVE_ASSIGNEE_HIGH=""
THEHIVE_ASSIGNEE_MEDIUM=""
THEHIVE_ASSIGNEE_DEFAULT=""
THEHIVE_DEFAULT_TLP=2
THEHIVE_DEFAULT_PAP=2

# Optional IOC enrichment providers. API keys stay server-side.
ENRICHMENT_TIMEOUT_MS=12000
ENRICHMENT_MAX_IOCS=25
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""
ABUSEIPDB_MAX_AGE_DAYS=90
OTX_API_KEY=""
